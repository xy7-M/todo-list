# ============================================================================
# 复制本文件为 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略，不会上传）
# Copy this file to .env.local and fill in real values.
# ============================================================================

# 服务端密钥 —— 严禁加 NEXT_PUBLIC_ 前缀（只在服务端/API 路由使用）
# Server-only secrets — never prefix with NEXT_PUBLIC_
SILICONFLOW_API_KEY=your-siliconflow-key
DEEPSEEK_API_KEY=your-deepseek-key

# Supabase —— 前端可读，需要 NEXT_PUBLIC_ 前缀
# Supabase —— safe to expose (publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
